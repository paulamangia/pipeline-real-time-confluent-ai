{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChamadoSuporte",
  "type": "object",
  "properties": {
    "id_chamado": {
      "type": "string",
      "description": "Identificador único do ticket"
    },
    "cliente": {
      "type": "string",
      "description": "Nome do cliente que abriu o chamado"
    },
    "mensagem": {
      "type": "string",
      "description": "Texto com o relato da dúvida ou problema"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de geração do evento"
    }
  },
  "required": ["id_chamado", "cliente", "mensagem", "timestamp"]
}
